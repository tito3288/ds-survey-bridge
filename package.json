{
  "name": "ds-survey-bridge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "test:db:schema": "supabase db reset --local && supabase test db --local supabase/tests/database/questionnaire_foundation.test.sql",
    "test:db:upgrade": "supabase db reset --local --version 001 --sql-paths tests/fixtures/legacy_before_002.sql && supabase migration up --local && supabase test db --local supabase/tests/upgrade/legacy_upgrade.test.sql",
    "test:db": "npm run test:db:schema && npm run test:db:upgrade",
    "db:types": "node scripts/database-types.mjs",
    "db:types:check": "node scripts/database-types.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "twilio": "^6.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^30.0.1",
    "nock": "^14.0.17",
    "postcss": "^8",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
