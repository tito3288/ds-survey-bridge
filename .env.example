# Application URL used to create customer survey links.
APP_URL=http://localhost:3000

# Supabase server connection. Never expose the service-role key to a browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-hosted-service-role-key

# Existing SMS delivery configuration.
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+15555550100

# Private-questionnaire email configuration. Separate recipients with commas.
RESEND_API_KEY=re_replace_me
SUPPORT_EMAIL=support@driveandshine.com

# Active overall-rating threshold. Ratings at or above this value use the
# location's mapped Google review page; lower ratings use private feedback.
# Must be a whole number from 1 through 5. Default: 4.
GOOGLE_REVIEW_MIN_RATING=4
